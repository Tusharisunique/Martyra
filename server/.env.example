# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-service-role-secret-key
PORT=3000
HOST=127.0.0.1

# Blockchain anchoring (all three required; leave blank to disable)
CHAIN_RPC_URL=https://rpc-amoy.polygon.technology
CHAIN_PRIVATE_KEY=your-dedicated-wallet-private-key
CONTRACT_ADDRESS=0xYourDeployedContractAddress
CHAIN_ID=80002

# Batch settings (optional, defaults shown)
BATCH_SECONDS=300
BATCH_MAX=500
CONFIRMATIONS=20

# Verifier only
SUPABASE_KEY=your-publishable-anon-key
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-admin-password
